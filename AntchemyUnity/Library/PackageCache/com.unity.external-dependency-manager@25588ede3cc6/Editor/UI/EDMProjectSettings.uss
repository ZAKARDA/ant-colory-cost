/* Compact icon buttons in the title row */
.edm-header-button {
    width: 22px;
    height: 22px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.edm-header-button:hover {
    background-color: rgba(128, 128, 128, 0.2);
}

/* Label column width for toggles and dropdowns */
.unity-base-field__label {
    min-width: 280px;
    width: 280px;
}

/* Legacy tab bar (2022.3 fallback — remove when TabView/Tab support is dropped) */
.edm-tab-button {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 4px;
    padding-bottom: 2px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
}

.edm-tab-button:hover {
    background-color: rgba(128, 128, 128, 0.1);
}

.edm-tab-button--selected {
    background-color: rgba(128, 128, 128, 0.08);
}

/* legacy */
.edm-tab-bar {
    background-color: rgba(0, 0, 0, 0.2);
}

/* Custom text-field row (Label + TextField) */
.edm-row {
    flex-direction: row;
    align-items: center;
}

.edm-row > .unity-label {
    min-width: 280px;
    width: 280px;
}

.edm-row > .unity-text-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
