<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.unity.external-dependency-manager/Editor/UI/EDMSelectionUIWindow.uss?fileID=7433441132597879392&amp;guid=3f4e97ed9898040bc8c8efb1be074ac6&amp;type=3#EDMSelectionUIWindow"/>
    <ui:VisualElement name="separator" class="separator" style="flex-grow: 1;"/>
    <ui:VisualElement name="topContainer" style="flex-grow: 1; width: auto; height: auto; padding-right: 24px; padding-left: 16px; border-top-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); padding-top: 12px;">
        <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" name="description" style="white-space: normal;"/>
    </ui:VisualElement>
    <ui:VisualElement name="bottomContainer" style="flex-grow: 1; white-space: normal; flex-direction: row; width: auto; height: auto; padding-top: 12px; padding-left: 16px; padding-right: 16px;">
        <ui:Label tabindex="-1" text="Learn More" parse-escape-sequences="true" display-tooltip-when-elided="true" name="learnMore" double-click-selects-word="false" triple-click-selects-line="false" class="hover-label" style="color: rgb(76, 126, 255); padding-top: 2px; padding-right: 1px;"/>
        <ui:VisualElement name="spacer" style="flex-grow: 100;"/>
        <ui:VisualElement name="buttonContainer" style="flex-grow: 1; flex-direction: row;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="leftButton" style="padding-left: 8px;"/>
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="rightButton" style="margin-right: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
